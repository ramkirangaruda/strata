# Copy to .env and adjust for a local run (docker compose reads this
# automatically; cmd/server reads the same variables directly from the
# environment either way).

# HTTP listen port.
PORT=8080

# Where strata keeps its WAL, SSTables and manifest. Defaults to ./data;
# automatically becomes /tmp/strata-data when VERCEL=1 is set.
STRATA_DATA_DIR=./data

# fsync every write. false survives the process dying; true survives the
# machine dying too. See docs/DESIGN.md section 4.
STRATA_SYNC=false
